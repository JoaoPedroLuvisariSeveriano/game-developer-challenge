# Copy to `.env.local` to override. All variables are optional.

# Base URL of the REST API. `/api` is served in-browser by MSW.
VITE_API_BASE_URL=/api

# Axios timeout in ms. Lower it (e.g. 1500) to reproduce timeout scenarios quickly.
VITE_API_TIMEOUT_MS=8000

# Base delay (ms) of the exponential retry backoff: base, 2x, 4x... (max 8 s).
VITE_RETRY_BASE_DELAY_MS=500

# Set to `false` to disable MSW and talk to a real backend.
VITE_ENABLE_MOCKS=true
